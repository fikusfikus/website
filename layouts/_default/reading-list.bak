{{ define "main" }}
<div class="doc container" id="doc">
  <aside class="aside" id="docs-sidebar">
    {{ partial "sidebar" . }}
  </aside>
  <main class="main main-index">
    <article class="article article-body fs-6">
      {{ $books := sort .Pages "Date" "desc" }}

	{{ range $books }}
  	<section class="book-entry">
    	{{ with .Params.cover }}<img src="{{ . }}" class="book-cover" alt="{{ $.Title }} cover">{{ end }}
    	<h2 class="book-title" id="{{ .File.ContentBaseName }}">{{ .Title }}</h2>
    	<p class="book-author">{{ .Params.author }}</p>
    	{{ with .Params.year }}<p class="book-year">{{ . }}</p>{{ end }}
    	<div class="book-review markdown">
      	{{ .Content }}
    	</div>
  	</section>
	{{ end }}

    </article>
    <aside class="toc">
      <div class="toc-content scrollable">
        <div class="toc-title has-icon fs-6 fw-500">
          {{ partial "svg" (dict "icon" "bars-sort") }}
          {{ i18n "contents" }}
        </div>
        <nav>
          <ul>
            {{ range $books }}
              <li><a href="#{{ .File.ContentBaseName }}">{{ .Title }}</a></li>
            {{ end }}
          </ul>
        </nav>
      </div>
    </aside>
  </main>
</div>
{{ end }}
